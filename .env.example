# ════════════════════════════════════════════════════════
# Expense Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════

# ── JWT ──────────────────────────────────────────────────
# IMPORTANT: Change this to a random string of 64+ characters
JWT_SECRET=change-me-to-a-very-long-and-secure-random-string-at-least-64-chars

# ── OpenAI ───────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=OPENAI_API_KEY=your-groq-api-key-here

# ── Google OAuth2 ────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/
# Authorized redirect URIs: http://localhost:8080/api/oauth2/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── GitHub OAuth2 ────────────────────────────────────────
# Create OAuth App at: https://github.com/settings/developers
# Callback URL: http://localhost:8080/api/oauth2/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Database (only needed if NOT using Docker Compose) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_intelligence
DB_USERNAME=postgres
DB_PASSWORD=postgres
